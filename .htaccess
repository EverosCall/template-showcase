# ====================================================================
# TEMPLATE SHOWCASE — REWRITE RULES FOR CLEAN URLS (/PAGES)
# ====================================================================

RewriteEngine On

# Si le fichier existe directement (assets, etc.), le servir
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Rediriger la racine vers pages/index.html
RewriteRule ^$ pages/index.html [L]

# Servir depuis le dossier pages/ sans afficher .html
RewriteCond %{DOCUMENT_ROOT}/pages/$1.html -f
RewriteRule ^([^/]+)/?$ pages/$1.html [L]

# Sécurité : masquer les fichiers cachés
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
